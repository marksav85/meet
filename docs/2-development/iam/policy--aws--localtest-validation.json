{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyDevResources",
      "Effect": "Deny",
      "Action": [
        "cloudformation:*",
        "lambda:*",
        "logs:*",
        "iam:*",
        "apigateway:*"
      ],
      "Resource": [
        "arn:aws:cloudformation:eu-central-1:__AWS_ACCOUNT_ID__:stack/auth-server-dev/*",
        "arn:aws:lambda:eu-central-1:__AWS_ACCOUNT_ID__:function:auth-server-dev-*",
        "arn:aws:logs:eu-central-1:__AWS_ACCOUNT_ID__:log-group:/aws/lambda/auth-server-dev-*",
        "arn:aws:iam::__AWS_ACCOUNT_ID__:role/auth-server-dev-*",
        "arn:aws:apigateway:eu-central-1::/restapis/__VERIFIED_DEV_REST_API_ID__",
        "arn:aws:apigateway:eu-central-1::/restapis/__VERIFIED_DEV_REST_API_ID__/*"
      ]
    },
    {
      "Sid": "DenyOtherRegionalEndpoints",
      "Effect": "Deny",
      "Action": [
        "cloudformation:*",
        "lambda:*",
        "apigateway:*",
        "logs:*",
        "ssm:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": "eu-central-1"
        }
      }
    },
    {
      "Sid": "ValidateTemplateAndDiscoverLogGroupNames",
      "Effect": "Allow",
      "Action": [
        "cloudformation:ValidateTemplate",
        "logs:DescribeLogGroups"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1"
        }
      }
    },
    {
      "Sid": "ReadLocaltestStack",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResource",
        "cloudformation:DescribeStackResources",
        "cloudformation:ListStackResources",
        "cloudformation:GetTemplate"
      ],
      "Resource": "arn:aws:cloudformation:eu-central-1:__AWS_ACCOUNT_ID__:stack/auth-server-localtest/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1"
        }
      }
    },
    {
      "Sid": "ReadLocaltestFunctions",
      "Effect": "Allow",
      "Action": [
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:GetPolicy",
        "lambda:ListVersionsByFunction",
        "lambda:ListTags"
      ],
      "Resource": [
        "arn:aws:lambda:eu-central-1:__AWS_ACCOUNT_ID__:function:auth-server-localtest-getAuthURL",
        "arn:aws:lambda:eu-central-1:__AWS_ACCOUNT_ID__:function:auth-server-localtest-getAccessToken",
        "arn:aws:lambda:eu-central-1:__AWS_ACCOUNT_ID__:function:auth-server-localtest-getCalendarEvents",
        "arn:aws:lambda:eu-central-1:__AWS_ACCOUNT_ID__:function:auth-server-localtest-getAuthURL:*",
        "arn:aws:lambda:eu-central-1:__AWS_ACCOUNT_ID__:function:auth-server-localtest-getAccessToken:*",
        "arn:aws:lambda:eu-central-1:__AWS_ACCOUNT_ID__:function:auth-server-localtest-getCalendarEvents:*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1"
        }
      }
    },
    {
      "Sid": "ReadIntendedExecutionRole",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListRoleTags"
      ],
      "Resource": "arn:aws:iam::__AWS_ACCOUNT_ID__:role/auth-server-localtest-eu-central-1-lambdaRole"
    },
    {
      "Sid": "ReadVerifiedLocaltestApi",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET"
      ],
      "Resource": [
        "arn:aws:apigateway:eu-central-1::/restapis/__VERIFIED_LOCALTEST_REST_API_ID__",
        "arn:aws:apigateway:eu-central-1::/restapis/__VERIFIED_LOCALTEST_REST_API_ID__/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1"
        }
      }
    },
    {
      "Sid": "ReadDeploymentBucketLocation",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::__VERIFIED_DEPLOYMENT_BUCKET_NAME__",
      "Condition": {
        "StringEquals": {
          "s3:ResourceAccount": "__AWS_ACCOUNT_ID__"
        }
      }
    },
    {
      "Sid": "ReadDeploymentBucketMetadata",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketVersioning",
        "s3:GetEncryptionConfiguration",
        "s3:GetBucketPublicAccessBlock"
      ],
      "Resource": "arn:aws:s3:::__VERIFIED_DEPLOYMENT_BUCKET_NAME__",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1",
          "s3:ResourceAccount": "__AWS_ACCOUNT_ID__"
        }
      }
    },
    {
      "Sid": "ListOnlyLocaltestArtifactPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::__VERIFIED_DEPLOYMENT_BUCKET_NAME__",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1",
          "s3:ResourceAccount": "__AWS_ACCOUNT_ID__"
        },
        "StringLike": {
          "s3:prefix": [
            "__VERIFIED_LOCALTEST_OBJECT_PREFIX__",
            "__VERIFIED_LOCALTEST_OBJECT_PREFIX__/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadOnlyLocaltestArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::__VERIFIED_DEPLOYMENT_BUCKET_NAME__/__VERIFIED_LOCALTEST_OBJECT_PREFIX__/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1",
          "s3:ResourceAccount": "__AWS_ACCOUNT_ID__"
        }
      }
    },
    {
      "Sid": "ReadFrameworkDeploymentBucketPointer",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Resource": "arn:aws:ssm:eu-central-1:__AWS_ACCOUNT_ID__:parameter/serverless-framework/deployment/s3-bucket",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1"
        }
      }
    }
  ]
}

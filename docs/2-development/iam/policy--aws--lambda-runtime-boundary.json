{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RuntimeLogGroupCreation",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup"
      ],
      "Resource": [
        "arn:aws:logs:eu-central-1:__AWS_ACCOUNT_ID__:log-group:/aws/lambda/auth-server-localtest-getAuthURL:*",
        "arn:aws:logs:eu-central-1:__AWS_ACCOUNT_ID__:log-group:/aws/lambda/auth-server-localtest-getAccessToken:*",
        "arn:aws:logs:eu-central-1:__AWS_ACCOUNT_ID__:log-group:/aws/lambda/auth-server-localtest-getCalendarEvents:*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1"
        }
      }
    },
    {
      "Sid": "RuntimeLogStreamWrites",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:eu-central-1:__AWS_ACCOUNT_ID__:log-group:/aws/lambda/auth-server-localtest-getAuthURL:log-stream:*",
        "arn:aws:logs:eu-central-1:__AWS_ACCOUNT_ID__:log-group:/aws/lambda/auth-server-localtest-getAccessToken:log-stream:*",
        "arn:aws:logs:eu-central-1:__AWS_ACCOUNT_ID__:log-group:/aws/lambda/auth-server-localtest-getCalendarEvents:log-stream:*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1"
        }
      }
    }
  ]
}

{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyDevResources",
      "Effect": "Deny",
      "Action": [
        "cloudformation:*",
        "lambda:*",
        "logs:*",
        "iam:*",
        "apigateway:*"
      ],
      "Resource": [
        "arn:aws:cloudformation:eu-central-1:__AWS_ACCOUNT_ID__:stack/auth-server-dev/*",
        "arn:aws:lambda:eu-central-1:__AWS_ACCOUNT_ID__:function:auth-server-dev-*",
        "arn:aws:logs:eu-central-1:__AWS_ACCOUNT_ID__:log-group:/aws/lambda/auth-server-dev-*",
        "arn:aws:iam::__AWS_ACCOUNT_ID__:role/auth-server-dev-*",
        "arn:aws:apigateway:eu-central-1::/restapis/__VERIFIED_DEV_REST_API_ID__",
        "arn:aws:apigateway:eu-central-1::/restapis/__VERIFIED_DEV_REST_API_ID__/*"
      ]
    },
    {
      "Sid": "DenyOtherRegionalEndpoints",
      "Effect": "Deny",
      "Action": [
        "cloudformation:*",
        "lambda:*",
        "apigateway:*",
        "logs:*",
        "ssm:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": "eu-central-1"
        }
      }
    },
    {
      "Sid": "CreateExecutionRoleWithFixedBoundary",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole"
      ],
      "Resource": "arn:aws:iam::__AWS_ACCOUNT_ID__:role/auth-server-localtest-eu-central-1-lambdaRole",
      "Condition": {
        "ArnEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::__AWS_ACCOUNT_ID__:policy/__ADMIN_OWNED_RUNTIME_BOUNDARY_POLICY_NAME__"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": "cloudformation.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ManageOnlyBoundedExecutionRole",
      "Effect": "Allow",
      "Action": [
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:DeleteRole"
      ],
      "Resource": "arn:aws:iam::__AWS_ACCOUNT_ID__:role/auth-server-localtest-eu-central-1-lambdaRole",
      "Condition": {
        "ArnEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::__AWS_ACCOUNT_ID__:policy/__ADMIN_OWNED_RUNTIME_BOUNDARY_POLICY_NAME__"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": "cloudformation.amazonaws.com"
        }
      }
    },
    {
      "Sid": "TagOnlyIntendedRoleViaCloudFormation",
      "Effect": "Allow",
      "Action": [
        "iam:TagRole",
        "iam:UntagRole"
      ],
      "Resource": "arn:aws:iam::__AWS_ACCOUNT_ID__:role/auth-server-localtest-eu-central-1-lambdaRole",
      "Condition": {
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": "cloudformation.amazonaws.com"
        }
      }
    },
    {
      "Sid": "DenyExecutionBoundaryChanges",
      "Effect": "Deny",
      "Action": [
        "iam:DeleteRolePermissionsBoundary",
        "iam:PutRolePermissionsBoundary"
      ],
      "Resource": "arn:aws:iam::__AWS_ACCOUNT_ID__:role/auth-server-localtest-eu-central-1-lambdaRole"
    },
    {
      "Sid": "DenyBoundaryPolicyMutation",
      "Effect": "Deny",
      "Action": [
        "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:SetDefaultPolicyVersion",
        "iam:DeletePolicy"
      ],
      "Resource": "arn:aws:iam::__AWS_ACCOUNT_ID__:policy/__ADMIN_OWNED_RUNTIME_BOUNDARY_POLICY_NAME__"
    }
  ]
}
